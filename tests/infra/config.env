# Lean defaults for CI infra runs via v6-infrastructure-sh
# Values can be overridden in shell environment.

ENVIRONMENT=CI
PYTHON_INTERPRETER=python3.12
VERSION_VANTAGE6=4.13.3
UI_ENABLED=false
SERVER_URL=http://host.docker.internal
DOCKER_REGISTRY=harbor2.vantage6.ai/infrastructure
STRICT_DATA_CHECKS=true
COLLABORATION_NAME=meta-ci
